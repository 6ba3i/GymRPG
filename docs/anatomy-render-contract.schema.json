{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/gymrpg/schemas/anatomy-render.v1.json",
  "title": "Gym RPG native 2D anatomy path manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "views",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "taxonomy_version": {
      "type": "string"
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "front",
        "back"
      ],
      "properties": {
        "front": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view_box"
          ],
          "properties": {
            "view_box": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "source_svg": {
              "type": "string"
            }
          }
        },
        "back": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view_box"
          ],
          "properties": {
            "view_box": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "source_svg": {
              "type": "string"
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "view",
          "path_ids",
          "subdivision_ids",
          "license_source"
        ],
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "enum": [
              "front",
              "back"
            ]
          },
          "path_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "subdivision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "license_source": {
            "type": "string"
          },
          "mapping_precision": {
            "enum": [
              "exact_visual",
              "merged_visual",
              "approximation"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "unrendered_subdivision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
