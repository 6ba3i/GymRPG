        "basis",
        "nutrients"
      ],
      "properties": {
        "type": {
          "const": "food"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "food_state": {
          "enum": [
            "raw",
            "cooked",
            "packaged",
            "unknown"
          ]
        },
        "basis": {
          "const": "per_100g"
        },
        "serving_g": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reference_url": {
          "type": [
            "string",
            "null"
          ]
